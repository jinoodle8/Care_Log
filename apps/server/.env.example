NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://carelog:carelog@localhost:5432/carelog

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

INVITE_CODE_EXPIRES_HOURS=24
MISSED_GRACE_MINUTES=30

# S3 / MinIO (M4~)
# 로컬은 docker-compose의 MinIO를 쓴다. AWS S3를 쓸 때는 S3_ENDPOINT를 비운다.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=carelog-vault
S3_ACCESS_KEY_ID=carelog
S3_SECRET_ACCESS_KEY=carelog-secret
S3_PRESIGN_EXPIRES_SECONDS=300
S3_OBJECT_LIFECYCLE_DAYS=30

# Expo Push (M3~)
EXPO_ACCESS_TOKEN=
